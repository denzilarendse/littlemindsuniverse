# Public/server routing
PUBLIC_APP_URL=https://littlemindsuniverse.co.za
CORS_ALLOWED_ORIGINS=https://littlemindsuniverse.co.za,https://www.littlemindsuniverse.co.za

# Supabase: publishable is safe for clients; secret is server-only and bypasses RLS.
SUPABASE_URL=https://zcokxljcsfkrlouzragv.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Milo server provider (Groq, server-only key)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
MILO_MODEL=openai/gpt-oss-120b
MILO_MAX_REQUESTS_5M=20

# LittleMinds Connect uses the LMU Supabase/Postgres/RLS stack.
# No third-party messaging provider secret is required for the Connect foundation.

# PayFast, server-only
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
PAYFAST_VERIFY_SANDBOX_SOURCE_IP=false

# Server-controlled display currencies. PayFast settlement remains ZAR.
SUPPORTED_DISPLAY_CURRENCIES=USD,ZAR,EUR,GBP
